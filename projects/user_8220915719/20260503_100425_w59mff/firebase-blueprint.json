{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance information.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "balance": { "type": "number" },
        "hasUsedFreePlan": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "email", "balance", "hasUsedFreePlan", "role", "joinedAt"]
    },
    "Server": {
      "title": "Server Instance",
      "description": "Details about a managed server instance.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "language": { "type": "string", "enum": ["python", "javascript"] },
        "plan": { "type": "string", "enum": ["free", "paid"] },
        "expiryDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "storage": { "type": "string" }
      },
      "required": ["ownerId", "name", "language", "plan", "expiryDate", "status", "storage"]
    },
    "Transaction": {
      "title": "Transaction Record",
      "description": "Records of credits used or added.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["purchase", "topup"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "timestamp"]
    },
    "TopupRequest": {
      "title": "Top-up Request",
      "description": "Requests from users to add balance.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System-wide notifications for users.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "type", "active", "createdAt"]
    },
    "AuthCredential": {
      "title": "Auth Credential",
      "description": "Internal credentials for custom auth flow. Restricted to admin access.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email", "password", "uid"]
    },
    "PasswordReset": {
      "title": "Password Reset",
      "description": "Internal records for password reset codes.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["email", "code", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles keyed by UID."
    },
    "/servers/{serverId}": {
      "schema": "Server",
      "description": "Server instances."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "History of financial events."
    },
    "/topup_requests/{requestId}": {
      "schema": "TopupRequest",
      "description": "Top-up balance requests."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global or user notifications."
    },
    "/site_settings/{settingId}": {
      "schema": "object",
      "description": "Global application properties like maintenance mode."
    },
    "/auth_credentials/{uid}": {
      "schema": "AuthCredential",
      "description": "Restricted authentication data."
    },
    "/password_resets/{email}": {
      "schema": "PasswordReset",
      "description": "Temporal codes for password recovery."
    }
  }
}
